<Project Sdk="Microsoft.NET.Sdk">

  <!-- sf-mod-build: builds a Starfield mod from one project file (sfmod.json): Papyrus compile with the modder's own
       Creation Kit compiler, the mod's Mutagen builder, the BA2 with the modder's own Archive2, a reproducible zip,
       and the sf-mod-check (sfmodcheck) release check.
         dotnet build src\SfModBuild -c Release
         dotnet pack src\SfModBuild -c Release -o out          the dotnet tool package (sf-mod-build.<v>.nupkg) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SfModBuild</RootNamespace>
    <AssemblyName>sf-mod-build</AssemblyName>
    <Version>0.4.0</Version>
    <Product>sf-mod-build</Product>
    <AssemblyTitle>sf-mod-build: build a Starfield mod from one project file</AssemblyTitle>
    <Company>Richard Bejtlich</Company>
    <Copyright>Copyright (C) 2026 Richard Bejtlich. GPL-3.0.</Copyright>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- the dotnet tool -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sf-mod-build</ToolCommandName>
    <PackageId>sf-mod-build</PackageId>
    <!-- run on .NET 10 and later too, when .NET 9 isn't installed -->
    <RollForward>Major</RollForward>
    <Authors>Richard Bejtlich</Authors>
    <Description>Builds a Starfield mod from one project file: Papyrus compile with your own Creation Kit compiler, your Mutagen builder, the BA2 with your own Archive2, a reproducible zip, and a release check.</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/taosecurity/sf-mod-build</PackageProjectUrl>
    <RepositoryUrl>https://github.com/taosecurity/sf-mod-build</RepositoryUrl>
    <PackageTags>starfield;mods;papyrus;mutagen;creation-kit;build</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SfModBuild.Tests" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
